{
  "crons": [
    {
      "path": "/api/cron/generate-blog-draft",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(robots.txt|llms.txt|sitemap.xml|open-knowledge.md)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow, all" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/open-knowledge(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow, all" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
